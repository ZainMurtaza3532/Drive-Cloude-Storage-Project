generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?   @map("password")
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret String? @db.Text
  defaultView   String    @default("GRID")
  themePreference String  @default("SYSTEM")
  notifications Boolean  @default(true)
  storageUsed   BigInt    @default(0)
  storageLimit  BigInt    @default(5368709120) // 5GB in bytes
  stripeCustomerId String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId String?
  stripeCurrentPeriodEnd DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  folders       Folder[]
  files         File[]
  folderAccesses FolderAccess[]
  uploadSessions UploadSession[]
  comments      Comment[]
}

model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Folder {
  id         String      @id @default(uuid())
  name       String
  parentId   String?
  parent     Folder?     @relation("FolderToFolder", fields: [parentId], references: [id])
  children   Folder[]    @relation("FolderToFolder")
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  files      File[]
  isStarred  Boolean     @default(false)
  isTrash    Boolean     @default(false)
  isVault    Boolean     @default(false)
  vaultSalt  String?
  vaultCheck String?     @db.Text
  trashedAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  shareLinks ShareLink[]
  access     FolderAccess[]
  uploadSessions UploadSession[]
}

model UploadSession {
  id          String   @id @default(uuid())
  userId      String
  fileId      String
  versionId   String
  folderId    String?
  s3Key       String
  s3UploadId  String
  name        String
  size        BigInt
  mimeType    String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([s3Key, s3UploadId])
  @@index([userId, createdAt])
}

enum FolderRole {
  VIEWER
  EDITOR
}

model FolderAccess {
  id        String     @id @default(cuid())
  folderId  String
  userId    String
  role      FolderRole @default(VIEWER)
  createdAt DateTime   @default(now())
  folder    Folder     @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([folderId, userId])
  @@index([userId])
}

model File {
  id         String      @id @default(uuid())
  name       String
  folderId   String?
  folder     Folder?     @relation(fields: [folderId], references: [id])
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  versions   FileVersion[]
  isStarred  Boolean     @default(false)
  isTrash    Boolean     @default(false)
  trashedAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  shareLinks ShareLink[]
  comments   Comment[]
}

model Comment {
  id         String    @id @default(uuid())
  fileId     String
  userId     String
  parentId   String?
  content    String    @db.Text
  positionX  Float?
  positionY  Float?
  pageNumber Int?
  createdAt  DateTime  @default(now())
  file       File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent     Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("CommentThread")

  @@index([fileId, createdAt])
  @@index([parentId])
}

model FileVersion {
  id            String   @id @default(uuid())
  fileId        String
  versionNumber Int
  size          BigInt
  mimeType      String
  isEncrypted   Boolean  @default(false)
  originalMimeType String?
  originalSize  BigInt?
  encryptionChunkSize Int?
  s3Key         String
  url           String
  isCurrent     Boolean  @default(false)
  createdAt     DateTime @default(now())
  file          File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, versionNumber])
  @@index([fileId, isCurrent])
}

enum Permission {
  VIEW
  EDIT
}

model ShareLink {
  id         String      @id @default(cuid())
  fileId     String?
  file       File?       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folderId   String?
  folder     Folder?     @relation(fields: [folderId], references: [id], onDelete: Cascade)
  token      String      @unique @default(uuid())
  permission Permission  @default(VIEW)
  isPublic   Boolean     @default(true)
  passwordHash String?
  expiresAt  DateTime?
  maxDownloads Int?
  downloadCount Int     @default(0)
  viewCount Int        @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([fileId])
  @@index([folderId])
}
