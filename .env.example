# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Database Connection (Neon Serverless Postgres)
# Get this from your Neon console (https://console.neon.tech)
DATABASE_URL="postgresql://<user>:<password>@ep-<endpoint>.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Supabase S3 Storage Configuration
# Get these from your Supabase Dashboard -> Project Settings -> Storage -> S3 Credentials
S3_REGION="eu-central-1" # Or your specific Supabase region
S3_ACCESS_KEY_ID="your-supabase-s3-access-key"
S3_SECRET_ACCESS_KEY="your-supabase-s3-secret-key"
S3_BUCKET_NAME="uploads"
S3_ENDPOINT="https://<project-id>.supabase.co/storage/v1/s3"

# Authentication Configuration (NextAuth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-unique-random-secret" # Generate with: openssl rand -base64 32
TWO_FACTOR_ENCRYPTION_KEY="generate-a-32-byte-base64-key" # Generate with: openssl rand -base64 32
CRON_SECRET="generate-a-unique-random-secret-for-scheduled-jobs"

# Canonical public origin used by metadata, sitemap, and robots.txt
SITE_URL="http://localhost:3000"

# Distributed API rate limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL="https://<your-database>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Stripe Billing (use matching test or live keys and Price IDs)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-publishable-key"
STRIPE_SECRET_KEY="sk_test_your-secret-key"
STRIPE_PRICE_ID_100GB="price_your-100gb-monthly-price-id"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-signing-secret"

# App config
PORT=3000
NODE_ENV="development"
